# Образец конфига клавиш: скопируйте в ~/.config/maills/keys.conf
# Формат: клавиша = команда   (# — комментарий, "клавиша = none" снимает привязку)
# Полный список команд — на экране справки (клавиша ?).

# стрелки (↑ ↓ ← →, PageUp/PageDown, Home/End) уже работают; добавим русскую раскладку для остальных клавиш
й = back-or-quit
а = toggle-flagged

# снять привязку
Q = none
